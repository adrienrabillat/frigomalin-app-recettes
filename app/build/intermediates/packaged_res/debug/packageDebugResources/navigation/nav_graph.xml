<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/landingFragment">

    <fragment
        android:id="@+id/landingFragment"
        android:name="com.example.frigomalin.ui.landing.LandingFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_landing">
        
        <action
            android:id="@+id/action_landing_to_search"
            app:destination="@id/searchFragment" />
        
        <action
            android:id="@+id/action_landing_to_readme"
            app:destination="@id/readmeFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.frigomalin.ui.search.SearchFragment"
        android:label="@string/search_title"
        tools:layout="@layout/fragment_search">
        
        <action
            android:id="@+id/action_search_to_detail"
            app:destination="@id/detailFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.example.frigomalin.ui.detail.DetailFragment"
        android:label="@string/detail_title"
        tools:layout="@layout/fragment_detail">
        
        <argument
            android:name="mealId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/readmeFragment"
        android:name="com.example.frigomalin.ui.readme.ReadmeFragment"
        android:label="@string/readme_title"
        tools:layout="@layout/fragment_readme" />

</navigation>
